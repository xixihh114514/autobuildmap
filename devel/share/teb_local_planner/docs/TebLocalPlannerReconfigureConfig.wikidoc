28.name= ~acc_lim_x
28.default= 0.5
28.type= double
28.desc=Maximum translational acceleration of the robot Range: 0.01 to 100.0
29.name= ~acc_lim_theta
29.default= 0.5
29.type= double
29.desc=Maximum angular acceleration of the robot Range: 0.01 to 100.0
30.name= ~is_footprint_dynamic
30.default= False
30.type= bool
30.desc=If true, updated the footprint before checking trajectory feasibility 
31.name= ~use_proportional_saturation
31.default= False
31.type= bool
31.desc=If true, reduce all twists components (linear x and y, and angular z) proportionally if any exceed its corresponding bounds, instead of saturating each one individually 
32.name= ~transform_tolerance
32.default= 0.5
32.type= double
32.desc=Tolerance when querying the TF Tree for a transformation (seconds) Range: 0.001 to 20.0
33.name= ~min_turning_radius
33.default= 0.0
33.type= double
33.desc=Minimum turning radius of a carlike robot (diff-drive robot: zero) Range: 0.0 to 50.0
34.name= ~wheelbase
34.default= 1.0
34.type= double
34.desc=The distance between the drive shaft and steering axle (only required for a carlike robot with 'cmd_angle_instead_rotvel' enabled); The value might be negative for back-wheeled robots! Range: -10.0 to 10.0
35.name= ~cmd_angle_instead_rotvel
35.default= False
35.type= bool
35.desc=Substitute the rotational velocity in the commanded velocity message by the corresponding steering angle (check 'axles_distance') 
36.name= ~max_vel_y
36.default= 0.0
36.type= double
36.desc=Maximum strafing velocity of the robot (should be zero for non-holonomic robots!). May be overruled by the max_vel_trans parameter Range: 0.0 to 100.0
37.name= ~max_vel_trans
37.default= 0.0
37.type= double
37.desc=Maximum linear velocity of the robot. Will limit max_vel_x and max_vel_y when their linear combination exceeds its value. When set to default 0.0, it will be set equal to max_vel_x. Range: 0.0 to 100.0
38.name= ~acc_lim_y
38.default= 0.5
38.type= double
38.desc=Maximum strafing acceleration of the robot Range: 0.01 to 100.0
39.name= ~xy_goal_tolerance
39.default= 0.2
39.type= double
39.desc=Allowed final euclidean distance to the goal position Range: 0.001 to 10.0
40.name= ~yaw_goal_tolerance
40.default= 0.1
40.type= double
40.desc=Allowed final orientation error to the goal orientation Range: 0.001 to 3.2
41.name= ~free_goal_vel
41.default= False
41.type= bool
41.desc=Allow the robot's velocity to be nonzero for planning purposes (the robot can arrive at the goal with max speed) 
42.name= ~trans_stopped_vel
42.default= 0.1
42.type= double
42.desc=Below what maximum velocity we consider the robot to be stopped in translation Range: 0.0 to std::numeric_limits<double>::infinity()
43.name= ~theta_stopped_vel
43.default= 0.1
43.type= double
43.desc=Below what maximum rotation velocity we consider the robot to be stopped in rotation Range: 0.0 to std::numeric_limits<double>::infinity()
44.name= ~min_obstacle_dist
44.default= 0.5
44.type= double
44.desc=Minimum desired separation from obstacles Range: 0.0 to 10.0
45.name= ~inflation_dist
45.default= 0.6
45.type= double
45.desc=Buffer zone around obstacles with non-zero penalty costs (should be larger than min_obstacle_dist in order to take effect) Range: 0.0 to 15.0
46.name= ~dynamic_obstacle_inflation_dist
46.default= 0.6
46.type= double
46.desc=Buffer zone around predicted locations of dynamic obstacles with non-zero penalty costs (should be larger than min_obstacle_dist in order to take effect) Range: 0.0 to 15.0
47.name= ~include_dynamic_obstacles
47.default= False
47.type= bool
47.desc=Specify whether the movement of dynamic obstacles should be predicted by a constant velocity model (this also changes the homotopy class search). If false, all obstacles are considered to be static. 
48.name= ~include_costmap_obstacles
48.default= True
48.type= bool
48.desc=Specify whether the obstacles in the costmap should be taken into account directly (this is necessary if no seperate clustering and detection is implemented) 
49.name= ~legacy_obstacle_association
49.default= False
49.type= bool
49.desc=If true, the old association strategy is used (for each obstacle, find the nearest TEB pose), otherwise the new one (for each teb pose, find only 'relevant' obstacles). 
50.name= ~obstacle_association_force_inclusion_factor
50.default= 1.5
50.type= double
50.desc=The non-legacy obstacle association technique tries to connect only relevant obstacles with the discretized trajectory during optimization, all obstacles within a specifed distance are forced to be included (as a multiple of min_obstacle_dist), e.g. choose 2.0 in order to consider obstacles within a radius of 2.0*min_obstacle_dist. Range: 0.0 to 100.0
51.name= ~obstacle_association_cutoff_factor
51.default= 5.0
51.type= double
51.desc=See obstacle_association_force_inclusion_factor, but beyond a multiple of [value]*min_obstacle_dist all obstacles are ignored during optimization. obstacle_association_force_inclusion_factor is processed first. Range: 1.0 to 100.0
52.name= ~costmap_obstacles_behind_robot_dist
52.default= 1.5
52.type= double
52.desc=Limit the occupied local costmap obstacles taken into account for planning behind the robot (specify distance in meters) Range: 0.0 to 20.0
53.name= ~obstacle_poses_affected
53.default= 30
53.type= int
53.desc=The obstacle position is attached to the closest pose on the trajectory to reduce computational effort, but take a number of neighbors into account as well Range: 0 to 200
54.name= ~obstacle_proximity_ratio_max_vel
54.default= 1.0
54.type= double
54.desc=Ratio of the maximum velocities used as an upper bound when reducing the speed due to the proximity to static obstacles Range: 0.0 to 1.0
55.name= ~obstacle_proximity_lower_bound
55.default= 0.0
55.type= double
55.desc=Distance to a static obstacle for which the velocity should be lower Range: 0.0 to 10.0
56.name= ~obstacle_proximity_upper_bound
56.default= 0.5
56.type= double
56.desc=Distance to a static obstacle for which the velocity should be higher Range: 0.0 to 10.0
57.name= ~no_inner_iterations
57.default= 5
57.type= int
57.desc=Number of solver iterations called in each outerloop iteration Range: 1 to 100
58.name= ~no_outer_iterations
58.default= 4
58.type= int
58.desc=Each outerloop iteration automatically resizes the trajectory and invokes the internal optimizer with no_inner_iterations Range: 1 to 100
59.name= ~optimization_activate
59.default= True
59.type= bool
59.desc=Activate the optimization 
60.name= ~optimization_verbose
60.default= False
60.type= bool
60.desc=Print verbose information 
