69.name= ~weight_kinematics_forward_drive
69.default= 1.0
69.type= double
69.desc=Optimization weight for forcing the robot to choose only forward directions (positive transl. velocities, only diffdrive robot) Range: 0.0 to 10000.0
70.name= ~weight_kinematics_turning_radius
70.default= 1.0
70.type= double
70.desc=Optimization weight for enforcing a minimum turning radius (carlike robots) Range: 0.0 to 1000.0
71.name= ~weight_optimaltime
71.default= 1.0
