79.name= ~weight_prefer_rotdir
79.default= 50.0
79.type= double
79.desc=Optimization weight for preferring a specific turning direction Range: 0.0 to 1000.0
80.name= ~weight_prefer_in_place_rotation
80.default= 0.0
