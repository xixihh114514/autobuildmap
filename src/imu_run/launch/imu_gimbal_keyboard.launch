<launch>
  <arg name="can_interface" default="can0" />
  <arg name="motor1_can_id" default="015" />
  <arg name="motor2_can_id" default="016" />
  <arg name="motor1_target_rpm" default="0.0" />
  <arg name="motor2_target_rpm" default="0.0" />
  <arg name="imu_cmd_vel_topic" default="/imu_cmd_vel" />
  <arg name="keyboard_speed_rpm" default="10.0" />
  <arg name="keyboard_repeat_rate" default="20.0" />
  <arg name="keyboard_backend" default="auto" />

  <node pkg="imu_run" type="imu_motor_control" name="imu_motor_control" output="screen">
    <param name="can_interface" value="$(arg can_interface)" />
    <param name="motor1_can_id" value="$(arg motor1_can_id)" />
    <param name="motor2_can_id" value="$(arg motor2_can_id)" />
    <param name="motor1_target_rpm" value="$(arg motor1_target_rpm)" />
    <param name="motor2_target_rpm" value="$(arg motor2_target_rpm)" />
    <param name="imu_cmd_vel_topic" value="$(arg imu_cmd_vel_topic)" />
  </node>

  <node pkg="imu_run" type="gimbal_keyboard_control.py" name="gimbal_keyboard_control" output="screen">
    <param name="cmd_topic" value="$(arg imu_cmd_vel_topic)" />
    <param name="speed_rpm" value="$(arg keyboard_speed_rpm)" />
    <param name="repeat_rate" value="$(arg keyboard_repeat_rate)" />
    <param name="keyboard_backend" value="$(arg keyboard_backend)" />
  </node>
</launch>
