<launch>
<!-- 定义世界文件的绝对路径 -->
  <arg name="world_name" default="$(find car)/worlds/robocup_box_easy.world"/>

  <!-- 启动 Gazebo 并传入世界文件参数 -->
  <!-- empty_world.launch 接收 world_name 参数来加载指定地图 -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <!-- 其他可选参数，如 paused, use_sim_time 等保持默认即可 -->
  </include>
  <!-- <node
    name="tf_footprint_base"
    pkg="tf"
    type="static_transform_publisher"
    args="0 0 0 0 0 0 base_footprint base_link 50" /> -->
  <!-- <node
    name="tf_body_footprint"
    pkg="tf"
    type="static_transform_publisher"
    args="-0.254900 0.003761 -0.228830 0 0 0 body base_footprint 50" /> -->
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-file $(find car)/urdf/car.urdf -urdf -model car"
    output="screen" />
  <node
    name="fake_joint_calibration"
    pkg="rostopic"
    type="rostopic"
    args="pub /calibrated std_msgs/Bool true" />
</launch>
