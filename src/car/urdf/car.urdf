  <!-- 二维激光雷达 -->
  <gazebo reference="lidar"> 
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>       
      <update_rate>40</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>         
            <resolution>1</resolution>      
            <min_angle> -3.14159265359</min_angle> 
            <max_angle> 3.14159265359</max_angle> 
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>                  
          <max>10.0</max>                 
          <resolution>0.01</resolution>   
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>            
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>                    
        <frameName>lidar</frameName>               
        <minRange>0.1</minRange>
        <maxRange>30.0</maxRange>
        <noiseStdDev>0.01</noiseStdDev>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RealSense D435i（官方D435i坐标系+realsense_gazebo_plugin） -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="camera_depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <camera name="depth_camera">
        <horizontal_fov>1.5184364492350666</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor type="camera" name="camera_ired1">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <camera name="infrared1_camera">
        <horizontal_fov>1.5184364492350666</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>L_INT8</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor type="camera" name="camera_ired2">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <pose>0 -0.050 0 0 0 0</pose>
      <camera name="infrared2_camera">
        <horizontal_fov>1.5184364492350666</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>L_INT8</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor type="camera" name="camera_color">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <pose>0 0.015 0 0 0 0</pose>
      <camera name="color_camera">
        <horizontal_fov>1.211258531</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="camera_imu_frame">
    <sensor type="imu" name="camera_imu_sensor">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>200.0</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00244</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00244</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00244</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.018</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.018</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.018</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="camera_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <topicName>/camera/imu</topicName>
        <frameName>camera_imu_frame</frameName>
        <updateRateHZ>200.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="realsense_d435i_controller" filename="librealsense_gazebo_plugin.so">
      <prefix>camera_</prefix>
      <depthUpdateRate>30.0</depthUpdateRate>
      <colorUpdateRate>30.0</colorUpdateRate>
      <infraredUpdateRate>30.0</infraredUpdateRate>
      <depthTopicName>/camera/depth/image_rect_raw</depthTopicName>
      <depthCameraInfoTopicName>/camera/depth/camera_info</depthCameraInfoTopicName>
      <colorTopicName>/camera/color/image_raw</colorTopicName>
      <colorCameraInfoTopicName>/camera/color/camera_info</colorCameraInfoTopicName>
      <infrared1TopicName>/camera/infra1/image_rect_raw</infrared1TopicName>
      <infrared1CameraInfoTopicName>/camera/infra1/camera_info</infrared1CameraInfoTopicName>
      <infrared2TopicName>/camera/infra2/image_rect_raw</infrared2TopicName>
      <infrared2CameraInfoTopicName>/camera/infra2/camera_info</infrared2CameraInfoTopicName>
      <colorOpticalframeName>camera_color_optical_frame</colorOpticalframeName>
      <depthOpticalframeName>camera_depth_optical_frame</depthOpticalframeName>
      <infrared1OpticalframeName>camera_ir_optical_frame</infrared1OpticalframeName>
      <infrared2OpticalframeName>camera_infra2_optical_frame</infrared2OpticalframeName>
      <rangeMinDepth>0.105</rangeMinDepth>
      <rangeMaxDepth>10.0</rangeMaxDepth>
      <pointCloud>true</pointCloud>
      <pointCloudTopicName>/camera/depth/color/points</pointCloudTopicName>
      <pointCloudCutoff>0.105</pointCloudCutoff>
      <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

  <!-- 运动学 -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace></namespace>
      </ros>
      <!-- FAST-LIO作为主里程计时，关闭Gazebo轮速里程计发布，避免与FAST-LIO重复发布里程计/TF -->
      <!-- 以前是true：用于纯Gazebo差速里程计；现在改为false：由FAST-LIO输出位姿 -->
      <publishOdom>ture</publishOdom>
      <publishOdomTF>ture</publishOdomTF>
      <publishWheelTF>false</publishWheelTF>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <leftJoint>left_ahead_wheel_joint</leftJoint>
      <leftJoint>left_back_wheel_joint</leftJoint>
      <rightJoint>right_ahead_wheel_joint</rightJoint>
      <rightJoint>right_back_wheel_joint</rightJoint>
      <wheelSeparation>0.438</wheelSeparation>
      <wheelDiameter>0.058</wheelDiameter>
      <wheelTorque>10.0</wheelTorque>
      <wheelAcceleration>10.0</wheelAcceleration>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <updateRate>100</updateRate>
    </plugin>
  </gazebo>


</robot>
