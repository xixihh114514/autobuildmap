<launch>
  <include
    file="$(find gazebo_ros)/launch/empty_world.launch" />
  <node
    name="tf_body_footprint"
    pkg="tf"
    type="static_transform_publisher"
    args="0 0 0 0 0 0 body base_footprint 100" />
  <node
    name="tf_footprint_base"
    pkg="tf"
    type="static_transform_publisher"
    args="0 0 0.025 0 0 0 base_footprint base_link 100" />
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-file $(find rebo24)/urdf/rebo24.urdf -urdf -model rebo24"
    output="screen" />
  <node
    name="fake_joint_calibration"
    pkg="rostopic"
    type="rostopic"
    args="pub /calibrated std_msgs/Bool true" />
</launch>
