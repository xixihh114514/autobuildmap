<launch>
    <!-- ==================== 基础参数 ==================== -->
    <arg name="namespace" default="" />               <!-- 可选命名空间 -->
    <!-- 自主建图需要注释掉 map_file -->
    <!-- <arg name="map_file" default="$(find sim_nav)/maps/my_map.yaml" /> -->
    <arg name="use_sim_time" default="false" />       <!-- Gazebo 必须开启 -->
    
    <!-- ==================== 局部规划器选择 ==================== -->
    <!-- 可选值：teb_local_planner/TebLocalPlannerROS 或 dwa_local_planner/DWAPlannerROS -->
    <arg name="local_planner" default="teb_local_planner/TebLocalPlannerROS" />

    <!-- ==================== 启动 move_base ==================== -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <!-- 必须的参数 -->
        <param name="base_global_planner" value="global_planner/GlobalPlanner" />   <!-- A* -->
        <param name="base_local_planner"  value="$(arg local_planner)" />

        <!-- 控制器频率与规划频率 -->
        <param name="controller_frequency" value="10.0"/>
        <param name="planner_patience"     value="5.0"/>
        <param name="controller_patience"  value="15.0"/>

       <!-- 恢复行为开关 -->
        <param name="recovery_behavior_enabled" value="true"/>
        <param name="clearing_rotation_allowed" value="true"/>
        <!-- 关闭默认的保守/激进恢复（我们自定义） -->
        <param name="conservative_reset_dist" value="3.0"/>
        <param name="aggressive_reset_dist"   value="1.5"/>

        <!-- 加载所有 yaml 配置文件 -->
        <rosparam file="$(find sim_nav)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find sim_nav)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />

        <rosparam file="$(find sim_nav)/config/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find sim_nav)/config/local_costmap_params.yaml"  command="load" />

        <rosparam file="$(find sim_nav)/config/global_planner.yaml" command="load" />
        
        <!-- 根据局部规划器选择加载不同的配置文件 -->
        <rosparam if="$(eval arg('local_planner') == 'teb_local_planner/TebLocalPlannerROS')" 
                  file="$(find sim_nav)/config/local_planner.yaml" command="load" />
        <rosparam if="$(eval arg('local_planner') == 'dwa_local_planner/DWAPlannerROS')" 
                  file="$(find sim_nav)/config/dwa_local_planner.yaml" command="load" />

        <rosparam file="$(find sim_nav)/config/recovery_behaviors.yaml" command="load" />

        <remap from="map" to="/map" />
    </node>

    <!-- ==================== 地图服务器（可选） ==================== -->
    <!-- 自主建图需要注释掉 -->
    <!-- <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)">
        <param name="frame_id" value="map" />
    </node> -->

    <!-- ==================== 其他常用节点 ==================== -->
    <!-- AMCL（如果你需要定位） -->
    <!-- <include file="$(find sim_nav)/launch/amcl.launch" /> -->

</launch>
