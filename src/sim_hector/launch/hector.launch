<?xml version="1.0"?>
<!-- launch文件用于启动hector_slam在ROS Noetic环境下的完整映射系统 -->
<launch>

  <!-- ========== 全局参数设置 ========== -->
  <!-- 设置是否使用仿真时间（如果使用gazebo等仿真环境，则设为true；真实机器人通常为false） -->
  <param name="/use_sim_time" value="true"/>

  <!-- 设置地图坐标系名称，通常为"map" -->
  <param name="map_frame" value="map"/>
  <!-- 设置机器人基坐标系名称，通常为"base_link" -->
  <param name="base_frame" value="base_link"/>
  <!-- 设置激光雷达坐标系名称，根据实际机器人TF树修改 -->
  <param name="odom_frame" value="base_link"/> <!-- hector_slam中odom_frame通常与base_frame一致，因为不依赖里程计 -->

  <!-- ========== 启动hector_mapping节点 ========== -->
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    
    <!-- 激光雷达话题名称，订阅传感器数据 -->
    <remap from="scan" to="/scan"/>
    
    <!-- 地图发布频率（Hz），建议10-40 -->
    <param name="pub_map_odom_transform" value="false"/>
    <param name="map_update_distance_thresh" value="0.2"/>
    <param name="map_update_angle_thresh" value="0.5"/>
    <param name="map_resolution" value="0.03"/> <!-- 地图分辨率，单位：米/格 -->
    <param name="map_size" value="2048"/>       <!-- 地图尺寸（格数），2^n推荐 -->
    <param name="map_start_x" value="0.5"/>     <!-- 地图初始位置偏移（比例） -->
    <param name="map_start_y" value="0.5"/>     <!-- 地图初始位置偏移（比例） -->
    <param name="laser_min_dist" value="0.15"/>
    <param name="laser_max_dist" value="12.0"/>
    <param name="laser_z_min_value" value="-0.5"/> <!-- 激光最小有效高度 -->
    <param name="laser_z_max_value" value="0.5"/>  <!-- 激光最大有效高度 -->
    <param name="update_factor_free" value="0.4"/>
    <param name="update_factor_occupied" value="0.7"/>
    <param name="map_pub_period" value="0.5"/>     <!-- 发布地图的周期（秒） -->
    <param name="advertise_map_service" value="true"/>
    <param name="scan_subscriber_queue_size" value="10"/>
    <param name="scan_topic" value="scan"/>

    <param name="pub_map_scanmatch_transform" value="true"/>

    <!-- 多层地图 -->
    <param name="use_multi_level_maps" value="true"/>      <!-- 启用多分辨率（默认 false） -->
    <param name="map_multi_res_levels" value="2"/>         <!-- 2 级金字塔 -->
    <param name="scanmatcher_max_iterations" value="30"/>  <!-- 增加迭代次数 -->
    
    <!-- 是否使用里程计数据（hector_slam可不依赖里程计，设为false更鲁棒） -->
    <param name="use_odometry" value="false"/>
    <!-- 如果使用TF提供位姿（替代里程计），可启用以下参数 -->
    <param name="pub_map_scanmatch_transform" value="true"/>
    <param name="tf_map_scanmatch_transform_frame_name" value="scanmatcher_frame"/>
  </node>

  <!-- ========== 启动hector_trajectory_server（可选，用于保存轨迹） ========== -->
  <!-- <node pkg="hector_trajectory_server" type="hector_trajectory_server" name="hector_trajectory_server" output="screen">
    <param name="target_frame_name" value="map"/>
    <param name="source_frame_name" value="base_link"/>
    <param name="trajectory_update_rate" value="4"/>
    <param name="trajectory_publish_rate" value="4"/>
  </node> -->

  <!-- ========== 启动hector_geotiff地图保存节点（用于保存地图为GeoTIFF格式） ========== -->
  <!-- <node pkg="hector_geotiff" type="geotiff_node" name="hector_geotiff_node" output="screen">
    <remap from="map" to="/map"/>
    <param name="map_file_path" value="$(find your_package_name)/maps"/>
    <param name="map_file_base_name" value="hector_map"/>
    <param name="geotiff_save_period" value="0"/>
  </node> -->

  <!-- ========== 启动RViz可视化（可选，便于调试） ========== -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find hector_slam_launch)/rviz_cfg/mapping_demo.rviz"/> -->

</launch>