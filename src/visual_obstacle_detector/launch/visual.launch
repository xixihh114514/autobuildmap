<launch>
  <!-- 共享输入话题 -->
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />

  <!-- 共享运行参数 -->
  <arg name="publish_debug_image" default="true" />
  <arg name="compute_target" default="gpu" />
  <arg name="global_frame" default="map" />
  <arg name="transform_timeout" default="0.05" />

  <!-- 人物定位参数 -->
  <arg name="person_model_path" default="$(find visual_obstacle_detector)/models/yolo.onnx" />
  <arg name="person_conf_threshold" default="0.5" />
  <arg name="person_min_confirm_frames" default="3" />
  <arg name="person_confirm_pixel_tolerance" default="60.0" />
  <arg name="person_confirm_timeout" default="0.5" />

  <!-- 二维码定位参数 -->
  <arg name="qr_backend" default="cpp" />
  <arg name="qr_min_confirm_frames" default="3" />
  <arg name="qr_confirm_pixel_tolerance" default="40.0" />
  <arg name="qr_confirm_timeout" default="0.5" />

  <include file="$(find visual_obstacle_detector)/launch/person_global_localizer.launch">
    <arg name="model_path" value="$(arg person_model_path)" />
    <arg name="color_topic" value="$(arg color_topic)" />
    <arg name="depth_topic" value="$(arg depth_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="conf_threshold" value="$(arg person_conf_threshold)" />
    <arg name="compute_target" value="$(arg compute_target)" />
    <arg name="publish_debug_image" value="$(arg publish_debug_image)" />
    <arg name="global_frame" value="$(arg global_frame)" />
    <arg name="transform_timeout" value="$(arg transform_timeout)" />
    <arg name="min_confirm_frames" value="$(arg person_min_confirm_frames)" />
    <arg name="confirm_pixel_tolerance" value="$(arg person_confirm_pixel_tolerance)" />
    <arg name="confirm_timeout" value="$(arg person_confirm_timeout)" />
  </include>

  <include file="$(find visual_obstacle_detector)/launch/qr_global_localizer.launch">
    <arg name="backend" value="$(arg qr_backend)" />
    <arg name="color_topic" value="$(arg color_topic)" />
    <arg name="depth_topic" value="$(arg depth_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="publish_debug_image" value="$(arg publish_debug_image)" />
    <arg name="compute_target" value="$(arg compute_target)" />
    <arg name="global_frame" value="$(arg global_frame)" />
    <arg name="transform_timeout" value="$(arg transform_timeout)" />
    <arg name="min_confirm_frames" value="$(arg qr_min_confirm_frames)" />
    <arg name="confirm_pixel_tolerance" value="$(arg qr_confirm_pixel_tolerance)" />
    <arg name="confirm_timeout" value="$(arg qr_confirm_timeout)" />
  </include>
</launch>
