<launch>
  <arg name="model_path" default="$(find visual_obstacle_detector)/models/yolo.pt" />
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />
  <arg name="conf_threshold" default="0.4" />
  <arg name="publish_debug_image" default="true" />

  <node pkg="visual_obstacle_detector"
        type="person_global_localizer.py"
        name="person_global_localizer"
        output="screen">
    <param name="model_path" value="$(arg model_path)" />
    <param name="color_topic" value="$(arg color_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="conf_threshold" value="$(arg conf_threshold)" />
    <param name="publish_debug_image" value="$(arg publish_debug_image)" />
  </node>
</launch>
