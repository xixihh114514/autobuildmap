<launch>
  <!-- 人物中心点全局定位节点：
       输入彩色图、对齐深度图和相机内参，输出人物中心点的相机系/地图系点云与调试标记 -->

  <!-- YOLO 模型路径 -->
  <arg name="model_path" default="$(find visual_obstacle_detector)/models/yolo.onnx" />
  <!-- 彩色图输入话题 -->
  <arg name="color_topic" default="/camera/color/image_raw" />
  <!-- 与彩色图对齐的深度图输入话题 -->
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <!-- 相机内参输入话题 -->
  <arg name="camera_info_topic" default="/camera/color/camera_info" />
  <!-- YOLO 目标置信度阈值 -->
  <arg name="conf_threshold" default="0.5" />
  <!-- 人物检测推理目标：auto/cpu/opencl/opencl_fp16 -->
  <arg name="compute_target" default="auto" />
  <!-- 本地 Intel OpenCL ICD 文件目录 -->
  <arg name="opencl_vendor_path" default="$(env HOME)/.local/intel-opencl-runtime/vendors" />
  <!-- 本地 Intel OpenCL 运行时库路径，末尾会拼接当前已有 LD_LIBRARY_PATH -->
  <arg name="opencl_ld_library_path" default="$(env HOME)/.local/intel-opencl-runtime/usr/lib:$(env HOME)/.local/intel-opencl-runtime/usr/lib/x86_64-linux-gnu/intel-opencl:$(env HOME)/.local/intel-opencl-runtime/usr/lib/x86_64-linux-gnu:$(optenv LD_LIBRARY_PATH)" />
  <!-- 是否发布带框选结果的调试图像 -->
  <arg name="publish_debug_image" default="true" />
  <!-- 全局输出坐标系，通常为 map -->
  <arg name="global_frame" default="map" />
  <!-- 相机系到全局系的 TF 变换等待时间 -->
  <arg name="transform_timeout" default="0.05" />
  <!-- 同一人物至少连续命中多少帧后才确认发布 -->
  <arg name="min_confirm_frames" default="3" />
  <!-- 连续帧匹配时允许的人物框中心像素偏移范围 -->
  <arg name="confirm_pixel_tolerance" default="60.0" />
  <!-- 连续帧确认允许的最大时间间隔 -->
  <arg name="confirm_timeout" default="0.5" />

  <!-- 启动人物全局定位节点 -->
  <node pkg="visual_obstacle_detector"
        type="person_global_localizer_node"
        name="person_global_localizer"
        output="screen">
    <!-- 为人物节点注入本地 Intel OpenCL 运行时环境 -->
    <env name="OPENCL_VENDOR_PATH" value="$(arg opencl_vendor_path)" />
    <env name="LD_LIBRARY_PATH" value="$(arg opencl_ld_library_path)" />
    <!-- 传入模型与输入输出相关参数 -->
    <param name="model_path" value="$(arg model_path)" />
    <param name="color_topic" value="$(arg color_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="conf_threshold" value="$(arg conf_threshold)" />
    <param name="compute_target" value="$(arg compute_target)" />
    <param name="publish_debug_image" value="$(arg publish_debug_image)" />
    <param name="global_frame" value="$(arg global_frame)" />
    <param name="transform_timeout" value="$(arg transform_timeout)" />
    <!-- 传入连续帧确认参数，用于抑制单帧误检 -->
    <param name="min_confirm_frames" value="$(arg min_confirm_frames)" />
    <param name="confirm_pixel_tolerance" value="$(arg confirm_pixel_tolerance)" />
    <param name="confirm_timeout" value="$(arg confirm_timeout)" />
  </node>
</launch>
