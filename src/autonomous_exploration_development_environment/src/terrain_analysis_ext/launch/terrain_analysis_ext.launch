<launch>

  <!--
    是否启用地形连通性检查：
    true  -> 检查地面可通行连通区域
    false -> 只做扩展地形图，不做连通性约束
  -->
  <arg name="checkTerrainConn" default="true"/>

  <!--
    延迟启动秒数：用于组合 launch 时等待上游节点先稳定
    默认 0，表示不延迟
  -->
  <arg name="delay_sec" default="0"/>

  <!--
    terrain_analysis_ext 作用：
    1) 订阅 /registered_scan、/state_estimation、/terrain_map
    2) 在 terrain_analysis 基础上构建更大范围地形
    3) 发布 /terrain_map_ext 给规划器（如 TARE）
  -->
  <node pkg="terrain_analysis_ext" type="terrainAnalysisExt" name="terrainAnalysisExt" output="screen" required="true"
        launch-prefix="bash -c 'sleep $(arg delay_sec); $0 $@'">
    <!-- 点云体素下采样分辨率（m），越大越省算力 -->
    <param name="scanVoxelSize" type="double" value="0.1" />

    <!-- 地图点衰减时间（s） -->
    <param name="decayTime" type="double" value="5.0" />
    <!-- 距离小于该值不衰减（m）；0 表示不过滤近场衰减保护 -->
    <param name="noDecayDis" type="double" value="0" />
    <!-- 清图半径（m） -->
    <param name="clearingDis" type="double" value="35.0" />

    <!-- 是否排序后再做高度统计 -->
    <param name="useSorting" type="bool" value="false" />
    <!-- 地面高度估计分位数（越小越贴近最低点） -->
    <param name="quantileZ" type="double" value="0.1" />

    <!-- 车辆高度参考（m） -->
    <param name="vehicleHeight" type="double" value="0.3" />
    <!-- 体素点数触发更新阈值 -->
    <param name="voxelPointUpdateThre" type="int" value="100" />
    <!-- 体素时间触发更新阈值（s） -->
    <param name="voxelTimeUpdateThre" type="double" value="2.0" />

    <!-- 相对高度窗口下界（m） -->
    <param name="lowerBoundZ" type="double" value="-0.2" />
    <!-- 相对高度窗口上界（m） -->
    <param name="upperBoundZ" type="double" value="0.3" />
    <!-- 随距离变化的高度放宽比例 -->
    <param name="disRatioZ" type="double" value="0.1" />

    <!-- 连通性检查开关（由 launch arg 传入） -->
    <param name="checkTerrainConn" type="bool" value="$(arg checkTerrainConn)" />
    <!-- 连通性阈值（越小越严格） -->
    <param name="terrainConnThre" type="double" value="0.5" />
    <!-- 车体下方地形补偿高度（m） -->
    <param name="terrainUnderVehicle" type="double" value="-0.3" />

    <!-- 天花板滤波阈值（m），抑制高处结构干扰 -->
    <param name="ceilingFilteringThre" type="double" value="2.0" />
    <!-- 局部地形图半径（m） -->
    <param name="localTerrainMapRadius" type="double" value="10.0" />
  </node>

</launch>
